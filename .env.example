# Postgres connection string (required)
DATABASE_URL=postgres://ellis:ellis@localhost:5432/ellis

# Anthropic API key used by the provider adapter (required to chat)
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace: the workspace ID to bill (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# Optional overrides
ELLIS_MODEL=claude-opus-5-5
ELLIS_EFFORT=low
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# First deploy only: creates this account if there are no users yet and prints
# its access token once in the server log. Ignored after that.
ELLIS_BOOTSTRAP_EMAIL=
ELLIS_BOOTSTRAP_TIMEZONE=UTC
